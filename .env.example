# Copy this file to `.env` and fill in the values. `.env` is loaded automatically.

# development | production
MEDIAI_ENV=development

# REQUIRED in production. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
MEDIAI_SECRET_KEY=

# Password for the `admin` account, used only when the database is first created.
# Dev default: admin123. In production, if blank, a random one is printed to the log once.
MEDIAI_ADMIN_PASSWORD=

# Server address (production defaults to 0.0.0.0 so other devices can connect)
MEDIAI_HOST=127.0.0.1
MEDIAI_PORT=5000

# Database file location (default: mediai.db in the project folder)
# MEDIAI_DB=C:\path\to\mediai.db

# Set to 1 when the site is served over HTTPS (makes cookies Secure-only, adds HSTS)
MEDIAI_HTTPS=0

# Set to 1 when running behind a reverse proxy (nginx, Caddy, IIS, a load balancer)
MEDIAI_TRUST_PROXY=0

# Extra origins allowed to open Socket.IO connections, comma-separated.
# Leave blank to allow only the site itself.
MEDIAI_CORS_ORIGINS=

# Lock a username/IP pair out after this many failed logins within the window (seconds)
MEDIAI_LOGIN_MAX_ATTEMPTS=5
MEDIAI_LOGIN_WINDOW=300

MEDIAI_LOG_LEVEL=INFO

# Email reports (optional). For Gmail use an App Password, not your normal password.
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=1
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=
